{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.86",
        "--browser",
        "msedge",
        "--user-data-dir",
        "./playwright-profile",
        "--output-dir",
        "./.playwright-mcp",
        "--viewport-size",
        "1440,900"
      ]
    }
  }
}
